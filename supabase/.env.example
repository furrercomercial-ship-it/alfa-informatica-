# Alfa Informática — placeholders das variáveis usadas pelas Edge Functions
# de pagamento (mp-create-payment, mp-webhook) e de envio (correios-frete,
# correios-etiqueta, correios-rastreio). NENHUM valor real vai aqui.
#
# Em produção (deployado), essas variáveis não vêm de arquivo nenhum — são
# configuradas uma vez, no seu computador, com:
#   supabase secrets set MP_ACCESS_TOKEN=SEU_ACCESS_TOKEN_DE_TESTE
#   supabase secrets set MP_WEBHOOK_SECRET=SEU_SEGREDO_DE_WEBHOOK
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=SUA_SERVICE_ROLE_KEY
#   supabase secrets set CORREIOS_MEU_CORREIOS_USUARIO=SEU_LOGIN_DO_MEU_CORREIOS
#   supabase secrets set CORREIOS_CWS_CHAVE_ACESSO=SUA_CHAVE_CRIADA_EM_CWS_CHAVES_DE_ACESSO
#   supabase secrets set CORREIOS_NUMERO_CONTRATO=SEU_NUMERO_DE_CONTRATO
#   supabase secrets set CORREIOS_ANO_CONTRATO=SEU_ANO_DE_CONTRATO
#   supabase secrets set CORREIOS_CODIGO_ADMINISTRATIVO=SEU_CODIGO_ADMINISTRATIVO
#   supabase secrets set CORREIOS_CEP_ORIGEM=SEU_CEP_DE_ORIGEM
#   supabase secrets set RESEND_API_KEY=SUA_API_KEY_DO_RESEND
#
# Este arquivo só é útil se você quiser rodar as functions localmente pra
# testar antes de fazer deploy, com:
#   cp supabase/.env.example supabase/.env   (e aí sim preenche os valores)
#   supabase functions serve --env-file supabase/.env
#
# supabase/.env (sem .example) já está no .gitignore — nunca vai ser commitado.

SUPABASE_URL=https://ybkgevyahpkkxhiexejy.supabase.co
SUPABASE_SERVICE_ROLE_KEY=COLOCAR_SERVICE_ROLE_KEY_AQUI
MP_ACCESS_TOKEN=COLOCAR_ACCESS_TOKEN_DE_TESTE_AQUI
MP_WEBHOOK_SECRET=COLOCAR_SEGREDO_DO_WEBHOOK_AQUI

# Correios — credenciais reais, nunca colar em nenhum arquivo além deste .example
CORREIOS_API_BASE=https://api.correios.com.br
# Basic Auth confirmado via Swagger do CWS: usuário = login do Meu Correios,
# senha = chave criada em CWS (cws.correios.com.br) > "Chaves de acesso" >
# "Criar nova chave" (formato cws-ch1_...).
CORREIOS_MEU_CORREIOS_USUARIO=COLOCAR_LOGIN_DO_MEU_CORREIOS_AQUI
CORREIOS_CWS_CHAVE_ACESSO=COLOCAR_CHAVE_CWS_AQUI
CORREIOS_NUMERO_CONTRATO=COLOCAR_NUMERO_DO_CONTRATO_AQUI
# Campos originais — confirmado que não são usados na autenticação (mantidos
# só porque já estavam configurados; sem efeito no código).
CORREIOS_TOKEN_AUTENTICACAO=COLOCAR_TOKEN_DE_AUTENTICACAO_AQUI
CORREIOS_CODIGO_ACESSO=COLOCAR_CODIGO_DE_ACESSO_AQUI
CORREIOS_TIPO_AUTORIZACAO=COLOCAR_TIPO_DE_AUTORIZACAO_AQUI
CORREIOS_ANO_CONTRATO=COLOCAR_ANO_DO_CONTRATO_AQUI
CORREIOS_CODIGO_ADMINISTRATIVO=COLOCAR_CODIGO_ADMINISTRATIVO_AQUI
# CEP de origem da loja — não é dado sensível, já vem certo como padrão no
# código (_shared/correios.ts) mesmo sem essa secret configurada; só
# preencher aqui se o CEP de origem mudar no futuro.
CORREIOS_CEP_ORIGEM=78065443
# Pacote padrão — só usado como fallback pra item sem peso/dimensão
# cadastrado (admin-produtos.html normalmente já exige isso por produto).
CORREIOS_PACOTE_PESO_KG=1
CORREIOS_PACOTE_COMPRIMENTO_CM=20
CORREIOS_PACOTE_LARGURA_CM=15
CORREIOS_PACOTE_ALTURA_CM=10

# Resend — envio de e-mails transacionais (PIX gerado, pedido confirmado,
# em análise, não aprovado). A RESEND_API_KEY é obrigatória; RESEND_FROM_EMAIL
# é opcional — sem ele usa onboarding@resend.dev (padrão Resend, funcional
# mas pode cair em spam).
#
# Para usar domínio próprio (pedidos@alfainformatica.com.br):
#   1. Acesse resend.com/domains e verifique o domínio alfainformatica.com.br
#   2. Crie o endereço pedidos@ no seu serviço de e-mail
#   3. Execute:
#        supabase secrets set RESEND_FROM_EMAIL="Alfa Informática <pedidos@alfainformatica.com.br>"
RESEND_API_KEY=COLOCAR_API_KEY_DO_RESEND_AQUI
RESEND_FROM_EMAIL=Alfa Informática <onboarding@resend.dev>
